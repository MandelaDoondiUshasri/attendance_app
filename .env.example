# ==============================================================================
# Enterprise HR & Attendance Platform - Environment Configuration Reference
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Settings (Render / Production Django API)
# ------------------------------------------------------------------------------
SECRET_KEY=generate-a-secure-random-key-for-production
DEBUG=False
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app,https://*.onrender.com
DATABASE_URL=postgresql://attendance_user:password@host:5432/attendance_db
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
SECURE_SSL_REDIRECT=True

# ------------------------------------------------------------------------------
# 2. Frontend Settings (Vercel Production React SPA)
# ------------------------------------------------------------------------------
VITE_API_URL=https://attendance-backend.onrender.com

# ------------------------------------------------------------------------------
# 3. GitHub Actions CI/CD Secrets (Optional for Automated Webhook Triggers)
# ------------------------------------------------------------------------------
# RENDER_DEPLOY_HOOK_URL=https://api.render.com/deploy/srv-xxxxxx?key=yyyyyy
# VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/prj_xxxx/yyyy
