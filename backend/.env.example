# ==============================================================================
# Backend Environment Configuration (Render Production & Local Development)
# ==============================================================================

# Security Settings
# Generate a strong secret key for production (e.g., using python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=your-super-secret-django-key-change-in-production

# Debug Mode: Set to False in Production, True in Development
DEBUG=False

# Comma-separated list of host/domain names that this Django site can serve
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1

# Comma-separated list of origins authorized to perform unsafe cross-site HTTP requests
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app,https://*.onrender.com,http://localhost:5173,http://127.0.0.1:5173

# Database Connection (Render Managed PostgreSQL connection string)
# Example: postgresql://user:password@dpg-xxxxxx.oregon-postgres.render.com/dbname
DATABASE_URL=postgresql://user:password@host:5432/dbname

# CORS (Cross-Origin Resource Sharing)
# In production, set CORS_ALLOW_ALL_ORIGINS=False and specify CORS_ALLOWED_ORIGINS
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# JWT Token Lifetimes
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Media Storage (Cloudinary)
# Create a free account at https://cloudinary.com/ and get your Environment variable
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# SSL & HTTPS
SECURE_SSL_REDIRECT=True
